# TaskFlow 환경 변수 예시
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다

# 서버
PORT=3000
DB_PATH=data/taskflow.db

# 알림 (종합 실습에서 사용)
# 이메일: 테스트는 Ethereal Email(https://ethereal.email) 가입 후 발급받은 자격증명 사용
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 슬랙: Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
